# OrderFlow Intelligence — configuração de ambiente.
#
# A engine lê os mesmos dados do PostgreSQL usado pelo backend Java.
# Use, de preferência, um usuário com permissão apenas de leitura (SELECT).
#
# Em Docker Compose, o host do banco é o nome do serviço: "postgres".
# Em execução local, normalmente é "localhost".

# String de conexão completa (tem prioridade sobre as variáveis abaixo).
# Ex.: postgresql+psycopg2://orderflow:orderflow@localhost:5432/orderflow_db
ORDERFLOW_DATABASE_URL=

# Alternativa por componentes (usada quando ORDERFLOW_DATABASE_URL está vazio):
ORDERFLOW_DB_HOST=localhost
ORDERFLOW_DB_PORT=5432
ORDERFLOW_DB_NAME=orderflow_db
ORDERFLOW_DB_USER=orderflow
ORDERFLOW_DB_PASSWORD=orderflow

# Regras de negócio
ORDERFLOW_LOW_STOCK_THRESHOLD=5      # estoque <= valor => alerta
ORDERFLOW_NO_TURNOVER_DAYS=60        # dias sem vendas => produto sem giro
ORDERFLOW_SALES_DROP_THRESHOLD=0.15  # queda >= 15% entre janelas => alerta
ORDERFLOW_RESTOCK_LEAD_TIME_DAYS=7   # dias de cobertura desejada na reposição

# CORS — origens autorizadas a chamar a engine (separadas por vírgula)
ORDERFLOW_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
