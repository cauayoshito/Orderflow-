# Base URL of the OrderFlow Commerce Cloud backend (Spring Boot API).
# For local dev with the backend on port 8080:
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Public URL of this app (used to build links inside emails).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# WebSocket endpoint for real-time order status (STOMP over SockJS).
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws

# Stripe publishable key (public, safe to expose in the browser).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Resend transactional email (server-side only). Without RESEND_API_KEY the
# email routes log and skip sending — the main flow keeps working.
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=onboarding@resend.dev

# Shared secret for the protected email routes (order-confirmation, order-status).
# Leave empty in dev (routes accept browser calls). When set, those routes
# require a matching x-internal-secret header (server-to-server only).
INTERNAL_API_SECRET=change-me-to-a-long-random-string

# NOTE: the Stripe secret key and webhook secret are BACKEND-only — never put
# them in the frontend. They are documented here only for reference and must be
# set on the backend (see backend/application.yml / docker-compose):
#   STRIPE_SECRET_KEY=sk_test_...
#   STRIPE_WEBHOOK_SECRET=whsec_...
