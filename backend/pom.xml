<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <!--
     OrderFlow API root POM.  This file defines the build configuration for
     the project and pulls in all necessary dependencies for building a REST
     API with Spring Boot, securing it using Spring Security and JWT, persisting
     data in PostgreSQL and exposing documentation via OpenAPI/Swagger.

     The Java version is pinned to 17 and Maven is used as the build tool.
    -->

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <groupId>com.orderflowapi</groupId>
    <artifactId>orderflow-api</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>OrderFlow API</name>
    <description>API de pedidos construída com Spring Boot</description>

    <properties>
        <!-- Define the Java release and JJWT version once to easily bump later. -->
        <java.version>17</java.version>
        <jjwt.version>0.11.5</jjwt.version>
        <!-- springdoc 2.x targets Spring Boot 3.x; the 3.x line targets Spring Boot 4. -->
        <springdoc.version>2.5.0</springdoc.version>
    </properties>

    <dependencies>
        <!-- Spring Boot starters provide default configuration and transitive dependencies. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- STOMP/WebSocket for real-time order status updates. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>
        <!-- Actuator exposes /actuator/health, used by the Docker healthcheck. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!--
          The AI module proxies the OrderFlow Intelligence engine (a proprietary
          Python/FastAPI service — no external AI API) over HTTP using Spring's
          built-in RestClient (see AiService).  No extra SDK is needed on the
          classpath, keeping the build reproducible.
        -->

        <!-- Stripe Java SDK for payments (PaymentIntent + webhook). -->
        <dependency>
            <groupId>com.stripe</groupId>
            <artifactId>stripe-java</artifactId>
            <version>26.3.0</version>
        </dependency>


        <!-- PostgreSQL JDBC driver. According to guidance on adding the driver for PostgreSQL, only the groupId and artifactId are required – Maven will pull the latest compatible version【704635673434218†L77-L83】. -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- JSON Web Token support. We pull in separate modules for the API, implementation and JSON-binding as recommended in recent Spring Boot JWT tutorials【659807652368891†L65-L81】. -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- SpringDoc OpenAPI/Swagger integration. Version 3.x works with Spring Boot 3 and exposes the Swagger UI at /swagger-ui.html by default【401697210459922†L40-L47】. -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- Bean validation API (Jakarta) is included transitively via spring-boot-starter-validation.  -->

        <!-- Test dependencies.  -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- In-memory database so integration tests run without a real PostgreSQL. -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Use the Spring Boot Maven plugin to create an executable jar. -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <!-- Exclude Lombok from the repackaged jar if it is ever added. -->
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <!-- Configure compiler plugin to target Java 17. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>